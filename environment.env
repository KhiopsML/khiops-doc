# Notes:
# - if KHIOPS_VIZ_VERSION is empty, the version of the latest release is used
KHIOPS_VERSION=11.0.1
# Version of the "Khiops" package as documented on the web site
KHIOPS_PYTHON_VERSION=11.0.1.0
# Git reference to the khiops-python repository
# (comment it to use the KHIOPS_PYTHON_VERSION Git reference)
KHIOPS_PYTHON_REF=main
KHIOPS_SAMPLES_VERSION=11.0.0
KHIOPS_PYTHON_TUTORIAL_VERSION=11.0.0.0
# KHIOPS_VIZ_VERSION=11.7.0 # Uncomment and update in case of documented regression in the latest release
KHIOPS_GCS_DRIVER_VERSION=0.0.23
KHIOPS_S3_DRIVER_VERSION=0.0.25
KHIOPS_AZURE_DRIVER_VERSION=0.0.18
